# Axis Hiring Agent — backend environment
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
# The server reads these at process start; restart uvicorn after changing.

# ---------------------------------------------------------------------------
# Provider selection — flip to `graph` to use real Microsoft Graph APIs.
# ---------------------------------------------------------------------------
AXIS_CALENDAR_PROVIDER=mock        # mock | graph
AXIS_MESSAGING_PROVIDER=mock       # mock | graph

# ---------------------------------------------------------------------------
# Microsoft Graph credentials — only required when either provider is `graph`.
# ---------------------------------------------------------------------------
# Get these from Azure portal -> Entra ID -> App registrations -> your app:
#   Tenant ID  = Overview page, "Directory (tenant) ID"
#   Client ID  = Overview page, "Application (client) ID"
#   Secret     = Certificates & secrets -> New client secret -> Value column
#
# Required Graph Application permissions (with admin consent granted):
#   Calendars.ReadWrite, OnlineMeetings.ReadWrite.All, Mail.Send,
#   Mail.ReadWrite, User.Read.All, MailboxSettings.Read
#
AXIS_GRAPH_TENANT_ID=
AXIS_GRAPH_CLIENT_ID=
AXIS_GRAPH_CLIENT_SECRET=

# The UPN of the mailbox that will organise meetings and send agent mail.
# This user must be licensed (Business Basic / E3 / E5 — anything with Exchange Online).
AXIS_GRAPH_ORGANISER_UPN=

# Optional — timezone used when building calendar events. Default: Asia/Kolkata
AXIS_GRAPH_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# ACS Teams Interview Agent — the live AI bot that joins the candidate's R1
# Microsoft Teams meeting, asks JD-aware questions, and captures the
# transcript. Default `mock` runs a fully offline simulation in a background
# thread (perfect for the demo). Flip to `azure` once the ACS resource +
# SDK + public webhook callback URL are provisioned.
# ---------------------------------------------------------------------------
AXIS_ACS_PROVIDER=mock              # mock | azure

# Connection string from: Azure Portal -> your Communication Services
# resource -> Keys -> Connection string (primary).
AXIS_ACS_CONNECTION_STRING=

# Public HTTPS base URL where ACS will POST CallAutomation webhook events
# (CallConnected, RecognizeCompleted, etc). For local dev use VS Code dev
# tunnels, ngrok, or Azure Dev Tunnels — must be https.
AXIS_ACS_BASE_URL=

# Mock provider only — seconds between simulated transcript lines.
# 0 = instant (used in tests). 1.5 = nice demo cadence.
AXIS_ACS_MOCK_QUESTION_DELAY=1.5

# Azure Speech (STT/TTS) — free tier covers 5 hrs of speech-to-text and
# 0.5M characters of TTS per month. Required only when AXIS_ACS_PROVIDER=azure.
AXIS_AZURE_SPEECH_KEY=
AXIS_AZURE_SPEECH_REGION=centralindia
